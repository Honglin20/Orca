# header.env — runtime injection header SKELETON (not sourced directly).
# render_run.sh renders the token placeholders below (<<name>> tokens — never
# {{name}}: agent.md is Jinja2-rendered and a {{name}} token would collide) and
# splices the result into every generated run script, so agents never
# hand-copy injection plumbing.
#
# Render points (authoritative values come from render_run.sh, never the LLM):
#   shadow_dir / shadow_pkgs   this run's shadow root and its top-level names
#   orca_inject_dir            artifacts orca_inject dir (sitecustomize lives here)
#   project_root               user project root (cwd for the entry command) —
#                              exported as ORCA_RUN_PROJECT_ROOT (a
#                              workflow-private name): the engine's own
#                              project-root env var resolves to the Orca
#                              repository root and must never be read or
#                              shadowed by a run script
#   pathsep                    os.pathsep OF THE TARGET INTERPRETER (probed at
#                              render time — never hardcode, a wrong separator
#                              kills the whole PYTHONPATH)
# The tokens appear ONLY on the export lines below on purpose: replacing them
# inside these comments would render the documentation meaningless.
export ORCA_SHADOW_DIR='<<shadow_dir>>'
export ORCA_SHADOW_PKGS='<<shadow_pkgs>>'
export ORCA_INJECT_DIR='<<orca_inject_dir>>'
export ORCA_RUN_PROJECT_ROOT='<<project_root>>'
export PYTHONPATH='<<orca_inject_dir>><<pathsep>><<project_root>><<pathsep>>'"${PYTHONPATH:-}"
